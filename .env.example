# Study Buddy Environment Configuration

# App
DEBUG=false

# Storage
STORAGE_BACKEND=json
STORAGE_PATH=./data

# Auth
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_EXPIRATION_HOURS=24

# Supabase (optional, for production)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your-anon-key

# Email (Mailgun)
# MAILGUN_API_KEY=your-mailgun-api-key
# MAILGUN_DOMAIN=your-mailgun-domain

# SMS (Twilio)
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=your-account-sid
# TWILIO_AUTH_TOKEN=your-auth-token
# TWILIO_PHONE_NUMBER=+1234567890

# AI (Anvil Serving router - self-hosted, OpenAI-compatible)
# Base URL of the Anvil router's /v1 endpoint
ANVIL_ROUTER_BASE_URL=https://your-router.your-tailnet.ts.net/v1
# Bearer token for the router
ANVIL_ROUTER_TOKEN=your-router-token
# Route/model id for text generation (router route name)
ANVIL_MODEL=llm.primary
# Legacy image setting; image generation is currently unavailable
# ANVIL_IMAGE_MODEL=

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Stable Fernet encryption key for per-user BYOK credentials (required in production).
# Generate once: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this key stable and back it up securely; changing it requires users to re-enter credentials.
# AI_CREDENTIALS_KEY=
# DEBUG=true may create STORAGE_PATH/.ai-credentials.key with mode 0600.
# External provider keys are entered per user in Settings; server environment vendor keys are never used.
# ANVIL_MODEL is retained for legacy clients; new user preferences default to llm.primary.
# Image generation is unavailable until an image output adapter is configured.

# Optional local Codex ChatGPT subscription (Anvil remains the default).
# Trusted loopback deployment only: authorize exactly one Study Buddy user UUID.
# Do not configure this on a publicly reachable or remotely shared server.
CODEX_SUBSCRIPTION_ENABLED=false
# CODEX_SUBSCRIPTION_USER_ID=your-study-buddy-user-uuid
# Absolute path to official codex-cli 0.162.1; other versions fail closed.
# CODEX_SUBSCRIPTION_BINARY=/absolute/path/to/codex
# Candidates are not entitlement discovery. Check selected model in Settings.
# CODEX_SUBSCRIPTION_MODELS=["gpt-6-luna"]
# Per-inference deadline in seconds (1–300); version/login checks have 20s deadlines.
# CODEX_SUBSCRIPTION_TIMEOUT_SECONDS=180
# Codex manages its existing ChatGPT login. Never copy auth.json or put tokens here.
# See docs/local-codex-subscription.md for setup and safety boundaries.
